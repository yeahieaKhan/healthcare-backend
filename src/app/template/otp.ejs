<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4f7fb; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 500px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="background-color: #2563eb; padding: 30px 20px"
              >
                <h1 style="color: #ffffff; margin: 0; font-size: 26px">
                  Verify Your Email
                </h1>
                <p style="color: #dbeafe; margin: 10px 0 0; font-size: 14px">
                  Secure your account with email verification
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 35px 30px; color: #334155">
                <h2 style="font-size: 21px; margin: 0 0 15px; color: #0f172a">
                  Hello <%= name %>!
                </h2>

                <p style="font-size: 15px; line-height: 1.7; margin: 0 0 20px">
                  Thank you for joining us! Please use the verification code
                  below to verify your email address and complete your
                  registration.
                </p>

                <!-- OTP -->
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td
                      align="center"
                      style="
                        background-color: #eff6ff;
                        border: 1px dashed #2563eb;
                        border-radius: 10px;
                        padding: 22px 10px;
                      "
                    >
                      <p
                        style="
                          margin: 0 0 10px;
                          color: #64748b;
                          font-size: 13px;
                        "
                      >
                        YOUR VERIFICATION CODE
                      </p>

                      <h1
                        style="
                          margin: 0;
                          color: #2563eb;
                          font-size: 34px;
                          letter-spacing: 8px;
                        "
                      >
                        <%= otp %>
                      </h1>
                    </td>
                  </tr>
                </table>

                <p style="font-size: 14px; line-height: 1.7; margin: 22px 0">
                  This code will expire in
                  <strong style="color: #dc2626">5 minutes</strong>. Please do
                  not share this code with anyone.
                </p>

                <p style="font-size: 14px; line-height: 1.7; margin: 0">
                  If you did not request this verification code, you can safely
                  ignore this email.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background-color: #f8fafc;
                  padding: 20px;
                  border-top: 1px solid #e2e8f0;
                "
              >
                <p style="font-size: 12px; color: #64748b; margin: 0 0 8px">
                  This is an automated email. Please do not reply.
                </p>

                <p style="font-size: 12px; color: #94a3b8; margin: 0">
                  &copy; <%= new Date().getFullYear() %> Your Company. All
                  rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
